# Copier en .env et remplacer les valeurs. Jamais de secret dans le dépôt.

# Base / file
DATABASE_URL=postgresql+psycopg://ncshift:ncshift@db:5432/ncshift
REDIS_URL=redis://redis:6379/0

# Stockage des fichiers bruts :
#   local = dossier monté (dev, démo) ; s3 = S3-compatible (prod, Scaleway) ;
#   off = aucune copie (réservé aux tests).
# MinIO a quitté Docker Hub en septembre 2026 : aucun serveur S3 local n'est requis.
STOCKAGE=local
STOCKAGE_LOCAL_DIR=/data
S3_ENDPOINT_URL=https://s3.fr-par.scw.cloud
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=ncshift

# Boîte mail dédiée (IMAP). Si IMAP_HOST est vide, le poller reste inactif.
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
IMAP_PROCESS_FOLDER=NCshift-traites

# Dossier partagé à surveiller (chemin vu par le conteneur worker)
WATCH_FOLDER=

# Organisation par défaut (MVP : le pilote)
ORGANISATION_DEFAUT=pilote
